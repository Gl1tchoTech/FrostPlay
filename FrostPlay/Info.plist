<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	AniDB's HTTP API is served over plain HTTP on port 9001, which App Transport
	Security blocks by default. This exception is deliberately scoped to that one
	host so no other request in FrostPlay is allowed to downgrade to HTTP.
	The rest of the app's Info.plist keys are still generated by Xcode
	(GENERATE_INFOPLIST_FILE = YES) and merged on top of this file.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>api.anidb.net</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
